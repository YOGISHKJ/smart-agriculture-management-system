# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=prefer
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agri_management_db

# MongoDB NoSQL Connection
# Format: mongodb://localhost:27017/agri_management_nosql or mongodb+srv://...
MONGODB_URI=mongodb://localhost:27017/agri_management_nosql
MONGODB_DB_NAME=agri_management_nosql

# Authentication & Security
JWT_SECRET=agri_jwt_super_secret_key_2025_experiential_learning_project_dbms
JWT_EXPIRES_IN=7d

# Application Configuration
NEXT_PUBLIC_APP_NAME="AgriPulse - Agriculture Resource and Farm Management System"
NEXT_PUBLIC_APP_ENV=development
NODE_ENV=development
PORT=3000
